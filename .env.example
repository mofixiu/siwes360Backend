# Copy to .env and fill in.

PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siwes360

# Long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Without it the server makes a random one per run, so everyone is signed out on restart.
JWT_SECRET=

# Password reset emails. Leave SMTP_HOST empty and the reset endpoints answer 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIWES360 <no-reply@example.com>"

# Local development only: print reset emails (including the code) to this console
# instead of sending them. Refused when NODE_ENV=production.
# MAIL_TRANSPORT=console
